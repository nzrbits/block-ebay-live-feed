{
  "manifest_version": 3,
  "name": "eBay Live Blocker",
  "version": "1.0.0",
  "description": "Removes eBay Live from eBay pages and redirects eBay Live URLs to the homepage.",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": [
    "*://*.ebay.com/*", "*://*.ebay.de/*", "*://*.ebay.at/*", "*://*.ebay.ch/*",
    "*://*.ebay.co.uk/*", "*://*.ebay.fr/*", "*://*.ebay.it/*", "*://*.ebay.es/*",
    "*://*.ebay.nl/*", "*://*.ebay.be/*", "*://*.ebay.pl/*", "*://*.ebay.ie/*",
    "*://*.ebay.ca/*", "*://*.ebay.com.au/*"
  ],
  "declarative_net_request": {
    "rule_resources": [{ "id": "redirect_live", "enabled": true, "path": "rules.json" }]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.ebay.com/*", "*://*.ebay.de/*", "*://*.ebay.at/*", "*://*.ebay.ch/*",
        "*://*.ebay.co.uk/*", "*://*.ebay.fr/*", "*://*.ebay.it/*", "*://*.ebay.es/*",
        "*://*.ebay.nl/*", "*://*.ebay.be/*", "*://*.ebay.pl/*", "*://*.ebay.ie/*",
        "*://*.ebay.ca/*", "*://*.ebay.com.au/*"
      ],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
